# Copy to the server as infra/.env.production and protect it with chmod 600.
# Replace every placeholder with a unique value. Never commit the real file.
DB_PASSWORD=replace-with-random-secret
DB_ROOT_PASSWORD=replace-with-a-different-random-secret
MEDIA_CONTROL_TOKEN=replace-with-random-secret
MEDIA_ANNOUNCED_ADDRESS=129.154.59.125
MEDIA_RTC_BIND_ADDRESS=0.0.0.0
MEDIA_ICE_SERVERS_JSON=[]
# Optional Coturn REST credentials. Set the same secret in Coturn and configure TURN URLs above.
# Use a unique random secret of at least 32 characters; leave blank when TURN is not configured.
MEDIA_TURN_SHARED_SECRET=
MEDIA_TURN_CREDENTIAL_TTL_SECONDS=21600
# Only needed when enabling the optional Compose `turn` profile.
# TURN_RELAY_IP=10.0.0.10
# TURN_EXTERNAL_IP=129.154.59.125
# TURN_REALM=town.gdgoc.com
# Optional: enables participant-consented AI transcripts for private-room recordings.
# Leave blank to keep transcription disabled; never commit a real provider key.
MEDIA_TRANSCRIPTION_API_KEY=
MEDIA_TRANSCRIPTION_API_BASE=https://api.openai.com/v1
MEDIA_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
WORLD_PUBLIC_ENDPOINT=wss://town.gdgoc.com/world/socket
TOWN_AUTH_MODE=sso
TOWN_PUBLIC_ORIGIN=https://town.gdgoc.com
TOWN_COOKIE_SECURE=true
TOWN_ASSET_ROOT=/data/assets
TOWN_MEDIA_ENABLED=true
# Optional comma-separated UUIDs of approved internal administrators; leave empty until assigned.
TOWN_ADMIN_USER_IDS=
HUFS_SSO_CLIENT_ID=hufs-town
HUFS_SSO_CLIENT_SECRET=replace-with-the-current-HUFS-SSO-secret
HUFS_SSO_REDIRECT_URI=https://town.gdgoc.com/auth/callback
HUFS_SSO_AUTHORIZE_URL=https://api.gdghufs.com/v1/sso/authorize
HUFS_SSO_USERINFO_URL=https://api.gdghufs.com/v1/sso/userinfo
