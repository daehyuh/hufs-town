# Copy to backend/.env. Secrets are loaded only by the backend/dev launcher.
TOWN_AUTH_MODE=sso
TOWN_PUBLIC_ORIGIN=http://localhost:5173
# Comma-separated exact browser origins for WebSocket handshakes.
TOWN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional public ws(s) node URLs, comma-separated; leave empty for same-origin routing.
TOWN_WORLD_ENDPOINTS=
TOWN_COOKIE_SECURE=false
TOWN_ASSET_ROOT=.local/hufs-town/assets
TOWN_WEB_PUSH_PUBLIC_KEY=
TOWN_WEB_PUSH_PRIVATE_KEY=
# Required: a valid mailto: contact or an HTTPS support URL.
TOWN_WEB_PUSH_SUBJECT=
# Optional comma-separated internal app_user UUIDs for the moderation console.
TOWN_ADMIN_USER_IDS=
HUFS_SSO_CLIENT_ID=hufs-town-local-test
HUFS_SSO_CLIENT_SECRET=
HUFS_SSO_REDIRECT_URI=http://localhost:5173/auth/callback
HUFS_SSO_AUTHORIZE_URL=https://api.gdghufs.com/v1/sso/authorize
HUFS_SSO_USERINFO_URL=https://api.gdghufs.com/v1/sso/userinfo
# Optional calendar connection. Google Calendar OAuth remains separate from HUFS SSO.
TOWN_GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5173/api/v1/calendar/google/callback
# Generate a random 32-byte key and Base64-encode it. Keep it stable for token decryption.
TOWN_CALENDAR_TOKEN_ENCRYPTION_KEY=
# scripts/media.ps1 start generates a local control secret and enables media.
TOWN_MEDIA_ENABLED=false
MEDIA_CONTROL_URL=http://127.0.0.1:18082
MEDIA_CONTROL_TOKEN=
# Optional STUN/TURN server list. With a shared secret, configure TURN URLs only;
# the media service issues short-lived Coturn REST credentials to each WebRTC client.
# Example: [{"urls":["turn:turn.example.com:3478?transport=udp"]}]
MEDIA_ICE_SERVERS_JSON=[]
MEDIA_TURN_SHARED_SECRET=
MEDIA_TURN_CREDENTIAL_TTL_SECONDS=21600
# Optional: enables participant-consented AI transcripts for private-room recordings.
# Leave blank to keep transcription disabled; never commit a real provider key.
MEDIA_TRANSCRIPTION_API_KEY=
MEDIA_TRANSCRIPTION_API_BASE=https://api.openai.com/v1
MEDIA_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
