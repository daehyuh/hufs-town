# Legacy example. Prefer .env.example -> .env for the registered localhost SSO client.
# Keep preview until the GDG HUFS SSO administrator registers this application.
# Switch to sso after filling both credentials and registering the exact callback.
TOWN_AUTH_MODE=preview
TOWN_PUBLIC_ORIGIN=http://localhost:5173
# Exact browser origins allowed for WebSocket handshakes.
TOWN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional comma-separated exact browser origins for WebSocket handshakes (e.g. Tailscale IP).
TOWN_ALLOWED_ORIGINS=
# Optional public ws(s) node URLs, comma-separated; leave empty for same-origin routing.
TOWN_WORLD_ENDPOINTS=
TOWN_COOKIE_SECURE=false
TOWN_ASSET_ROOT=.local/hufs-town/assets
HUFS_SSO_CLIENT_ID=
HUFS_SSO_CLIENT_SECRET=
HUFS_SSO_REDIRECT_URI=http://localhost:5173/auth/callback
HUFS_SSO_AUTHORIZE_URL=https://api.gdghufs.com/v1/sso/authorize
HUFS_SSO_USERINFO_URL=https://api.gdghufs.com/v1/sso/userinfo
